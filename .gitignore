# Independent code repos — tracked in their own git, ignored here
data_creation/
font-classify/

# Python / JS tooling cruft (in case any spills into the root)
.venv/
__pycache__/
*.pyc
.DS_Store
.ipynb_checkpoints/
node_modules/
src/rater/node_modules/
src/rater/dist/
src/app/dist/
src/app/node_modules/

# Word exports generated by to_docx.py (Word locks them; breaks git pull)
chapters/*/draft.docx

# Build outputs if a paper is compiled later
*.pdf      # ponytail: drop this line later if you want to commit the final PDF
*.aux
*.log
*.out
chapters/appendices/srs/SRS.docx

# Rendered corpus only — ~540 MB, regenerable from src/data/render_corpus.py.
# data/fonts/ (the 80 pinned TTFs) and data/raw/ (the Google Fonts index snapshot)
# are committed on purpose: they are the pin, so no clone ever re-downloads.
data/corpus/
data/corpus_unknown/
data/corpus_mixed/
data/corpus_background/
data/corpus_background_x3/

# Increment 2 — cached backbone features (~140 MB/backbone) and trained weights,
# regenerable from src/model/. reports/incr2/*.json (the metrics) is committed.
data/features/
data/models/

# Real-generative evaluation set (src/model/real.py). Images and crops are large;
# predictions.csv stays out of this public repo so raters cannot see it before labelling.
data/real/images/
data/real/crops/
data/real/sheet_*.png
data/real/predictions.csv
# Full localizer output; crops.csv holds the selected subset (src/data/generate_real.py select).
data/real/crops_all.csv

# rater identity: secrets and private data (only the audit head and the receipts are published)
data/real/raters.private.json
data/real/controls.private.json
data/real/audit.jsonl
data/real/labels_controls.csv
